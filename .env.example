# Postgres (Neon). Required in production.
DATABASE_URL=postgres://user:pass@host/dbname

# SHA-256 hex of `fountain:` + keeper phrase.
#   node scripts/hash-keeper.mjs "your phrase"
# Never commit the phrase or this hash.
KEEPER_HASH=

# Extra key for wrapping the NWC/LNbits blob at rest.
# If unset, the wrap key is derived from DATABASE_URL.
WALLET_WRAP_KEY=

# Optional. Leave false. This app does not use accounts.
VITE_AUTH_ENABLED=false
